--==================================================
-- TEAM CHECK
--==================================================

local function isSameTeam(player)

    return player.Team ~= nil
        and LocalPlayer.Team ~= nil
        and player.Team == LocalPlayer.Team
end

--==================================================
-- EQUIPPED WEAPONS
--==================================================

local function hasEquippedWeapon(name)

    local character = LocalPlayer.Character

    if not character then
        return false
    end

    local tool = character:FindFirstChild(name)

    return tool ~= nil and tool:IsA("Tool")
end

--==================================================
-- SAVE ORIGINAL HEAD
--==================================================

local function saveOriginalHead(head)

    if originalHeads[head] then
        return
    end

    local meshes = {}

    for _, child in ipairs(head:GetChildren()) do

        if child:IsA("SpecialMesh") then
            table.insert(meshes, child:Clone())
        end
    end

    originalHeads[head] = {
        Size = head.Size,
        Transparency = head.Transparency,
        Color = head.Color,
        Material = head.Material,
        CanCollide = head.CanCollide,
        CanTouch = head.CanTouch,
        Massless = head.Massless,
        Meshes = meshes
    }
end

--==================================================
-- RESTORE HEAD
--==================================================

local function restoreHead(head)

    local original = originalHeads[head]

    if not original then
        return
    end

    if head and head.Parent then

        head.Size = original.Size
        head.Transparency = original.Transparency
        head.Color = original.Color
        head.Material = original.Material

        head.CanCollide = original.CanCollide
        head.CanTouch = original.CanTouch
        head.Massless = original.Massless

        local blockMesh =
            head:FindFirstChild("HeadExpanderBlockMesh")

        if blockMesh then
            blockMesh:Destroy()
        end

        for _, child in ipairs(head:GetChildren()) do

            if child:IsA("SpecialMesh") then
                child:Destroy()
            end
        end

        for _, mesh in ipairs(original.Meshes) do
            mesh:Clone().Parent = head
        end
    end

    originalHeads[head] = nil
end

--==================================================
-- APPLY EXPANDER
--==================================================

local function applyHeadChanges(head)

    if not head or not head:IsA("BasePart") then
        return
    end

    saveOriginalHead(head)

    head.Size = Vector3.new(
        HEAD_SIZE,
        HEAD_SIZE,
        HEAD_SIZE
    )

    -- Red
    head.Color = Color3.fromRGB(255, 0, 0)

    head.Transparency = HEAD_TRANSPARENCY
    head.Material = Enum.Material.Neon

    -- Prevent collision
    head.CanCollide = false
    head.CanTouch = false
    head.Massless = true

    -- Remove SpecialMesh
    for _, child in ipairs(head:GetChildren()) do

        if child:IsA("SpecialMesh") then
            child:Destroy()
        end
    end

    -- Make sure BlockMesh exists
    local blockMesh =
        head:FindFirstChild("HeadExpanderBlockMesh")

    if not blockMesh then

        blockMesh = Instance.new("BlockMesh")
        blockMesh.Name = "HeadExpanderBlockMesh"
        blockMesh.Parent = head
    end

    blockMesh.Scale = Vector3.new(1, 1, 1)
end

--==================================================
-- PROCESS CHARACTER
--==================================================

local function processCharacter(player, character)

    if player == LocalPlayer or not character then
        return
    end

    local head = character:FindFirstChild("Head")

    if not head or not head:IsA("BasePart") then
        return
    end

    if not ENABLED then
        restoreHead(head)
        return
    end

    if TEAM_CHECK_ENABLED and isSameTeam(player) then
        restoreHead(head)
        return
    end

    if KNIFE_CHECK_ENABLED
        and hasEquippedWeapon(KNIFE_NAME) then

        restoreHead(head)
        return
    end

    if MUSKET_CHECK_ENABLED
        and hasEquippedWeapon(MUSKET_NAME) then

        restoreHead(head)
        return
    end

    applyHeadChanges(head)
end

--==================================================
-- PLAYER SETUP
--==================================================

local function setupPlayer(player)

    if player == LocalPlayer then
        return
    end

    player.CharacterAdded:Connect(function(character)

        task.defer(function()
            processCharacter(player, character)
        end)

        character.ChildAdded:Connect(function(child)

            if child:IsA("BasePart")
                and child.Name == "Head" then

                task.defer(function()
                    processCharacter(player, character)
                end)
            end
        end)
    end)

    player.CharacterAppearanceLoaded:Connect(function(character)

        task.defer(function()
            processCharacter(player, character)
        end)
    end)

    player:GetPropertyChangedSignal("Team"):Connect(function()

        local character = player.Character

        if character then
            processCharacter(player, character)
        end
    end)

    if player.Character then

        task.defer(function()
            processCharacter(player, player.Character)
        end)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)
