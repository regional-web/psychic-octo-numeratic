    stroke.Parent = button

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 3)
    corner.Parent = button

    -- Label stays in a fixed position
    local labelText = text:gsub(": ON$", ""):gsub(": OFF$", "")

