--==================================================
-- DRAGGABLE TOGGLE
--==================================================

local draggingToggle = false
local dragStart
local toggleStartPosition

toggle.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingToggle = true

        dragStart = input.Position
        toggleStartPosition = toggle.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)

    if not draggingToggle then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta =
            input.Position - dragStart

        toggle.Position = UDim2.new(
            toggleStartPosition.X.Scale,
            toggleStartPosition.X.Offset + delta.X,
            toggleStartPosition.Y.Scale,
            toggleStartPosition.Y.Offset + delta.Y
        )

        -- Keep the window near the toggle
        panel.Position = UDim2.new(
            toggle.Position.X.Scale,
            toggle.Position.X.Offset - 180,
            toggle.Position.Y.Scale,
            toggle.Position.Y.Offset + 55
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingToggle = false
    end
end)

--==================================================
-- CONSTANT HEAD UPDATER
--==================================================

task.spawn(function()

    while true do

        local knifeBlocking =
            KNIFE_CHECK_ENABLED
            and hasEquippedWeapon(KNIFE_NAME)

        local musketBlocking =
            MUSKET_CHECK_ENABLED
            and hasEquippedWeapon(MUSKET_NAME)

        --==================================================
        -- EXPANDER OFF
        --==================================================

        if not ENABLED then

            for head in pairs(originalHeads) do
                restoreHead(head)
            end

        --==================================================
        -- ANTI-KNIFE / ANTI-MUSKET
        --==================================================

        elseif knifeBlocking or musketBlocking then

            for head in pairs(originalHeads) do
                restoreHead(head)
            end

        --==================================================
        -- NORMAL UPDATE
        --==================================================

        else

            for _, player in ipairs(Players:GetPlayers()) do

                if player ~= LocalPlayer then

                    local character = player.Character

                    if character then

                        local head =
                            character:FindFirstChild("Head")

                        if head and head:IsA("BasePart") then

                            if TEAM_CHECK_ENABLED
                                and isSameTeam(player) then

                                restoreHead(head)

                            else

                                applyHeadChanges(head)

                            end
                        end
                    end
                end
            end
        end

        task.wait(UPDATE_INTERVAL)
    end
end)
